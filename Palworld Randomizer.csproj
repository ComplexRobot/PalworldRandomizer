<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>2.16.3</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>True</UseWPF>
    <StartupObject>PalworldRandomizer.App</StartupObject>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", ""))</RootNamespace>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputType>WinExe</OutputType>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202607" />
    <PackageReference Include="ini-parser" Version="3.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <EmbeddedResource Update="Resources\Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
	<Resource Include="Resources\icon.ico" />
	<Resource Include="Resources\Images\**" />
  </ItemGroup>

</Project>
<Project>
    <Import Project="../../Directory.Build.props" />
    <PropertyGroup>
        <!-- Keep the cross-platform regression runner separate from the WPF build outputs. -->
        <OutputPath>$(MSBuildThisFileDirectory)../../.build/Tests/$(Configuration)/</OutputPath>
        <BaseIntermediateOutputPath>$(OutputPath)obj/</BaseIntermediateOutputPath>
        <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
        <IsAotCompatible>false</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>
    </PropertyGroup>
</Project>
